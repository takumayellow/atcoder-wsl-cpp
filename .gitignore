.vscode/**
!c_cpp_properties.json
!launch.json
!tasks.json

# include ACL in repo (we remove ignore)
# ac-library/**

# AtCoder のログインセッション。PC のローカルにだけ置き、リポジトリには入れない
cookie.json
cookie.jar
session.json

*.in
*.out

# ビルド成果物（g++ の出力。ソースから再生成できるのでコミットしない）
# 'main' は拡張子なしの実行ファイル (Linux/WSL)。main.cpp / main.py には一致しない
*.exe
*.o
main

# tools/build_slides.sh --preview が吐くページ画像（目視確認用。毎回作り直す）
.slides_preview/

# .NET のビルド成果物（main.cs / main.csproj から再生成できる）
bin/
obj/

# TeX intermediate files
*.aux
*.dvi
*.fdb_latexmk
*.fls
*.log
*.nav
*.snm
*.toc
*.vrb

# 原本（撮影画像・スキャン・図の書き出し・配布された問題 PDF）は Box に置き、リポジトリには入れない
# 置き場所の対応は docs/handwritten-memos.md
*.jpg
*.jpeg
*.png
*.heic
memo.pdf
*_DESIGN_REF.pdf
*-problemset.pdf
